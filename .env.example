# ─────────────────────────────────────────────────────────────
# LOCAL AI — NVIDIA Cosmos3 served by vLLM (OpenAI-compatible)
# Start it from the cosmos-framework folder (needs an NVIDIA GPU):
#
#   VLLM_USE_DEEP_GEMM=0 uvx --with-editable ./packages/vllm-cosmos3 \
#     --torch-backend=cu130 vllm@0.21.0 serve nvidia/Cosmos3-Nano \
#     --hf-overrides '{"architectures": ["Cosmos3ReasonerForConditionalGeneration"]}' \
#     --tensor-parallel-size 1 --mm-encoder-tp-mode data --async-scheduling \
#     --port 8000
#
# Wait for "Application startup complete." (~5 min the first time).
# ─────────────────────────────────────────────────────────────
LOCAL_AI_BASE_URL=http://localhost:8000/v1
LOCAL_AI_MODEL=nvidia/Cosmos3-Nano
LOCAL_AI_API_KEY=local
# LOCAL_AI_TIMEOUT_MS=120000
# LOCAL_AI_DISABLED=true     # use plain templates, no AI

# ─────────────────────────────────────────────────────────────
# MAILBOX — the one email account DueCollect sends from AND reads
# customer replies from. Gmail/Outlook/Yahoo hosts are auto-detected.
# Gmail/Outlook need an "app password" (not your normal password),
# and IMAP must be enabled on the account.
# ─────────────────────────────────────────────────────────────
MAIL_EMAIL=billing@yourdomain.com
MAIL_PASSWORD=your-app-password
# MAIL_FROM="Your Business <billing@yourdomain.com>"
# Only for non-Gmail/Outlook/Yahoo providers:
# MAIL_SMTP_HOST=smtp.yourprovider.com
# MAIL_SMTP_PORT=587
# MAIL_IMAP_HOST=imap.yourprovider.com
# MAIL_IMAP_PORT=993

# How often to check the mailbox for payment replies (seconds, 0 = off)
INBOX_POLL_SECONDS=60

# Min AI confidence (0-1) to auto-mark an invoice paid from a customer's bill.
# Anything below, or failing any check, is sent to the admin to review.
AUTO_SETTLE_MIN_CONFIDENCE=0.75

# Public URL used in emails
APP_BASE_URL=http://localhost:3000

# Admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=long-random-string

# Optional fallbacks used only if the admin has NOT uploaded a QR
PAYMENT_UPI_ID=yourname@upi
PAYMENT_PAYEE_NAME=Your Business
PAYMENT_NOTE_PREFIX=INV

# Optional: lets a cron job call /api/inbox/poll with "Authorization: Bearer <this>"
# CRON_SECRET=another-long-random-string
