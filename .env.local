# Nebius Token Factory — https://tokenfactory.nebius.com
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# Public URL used in emails + QR links
APP_BASE_URL=http://localhost:3000

# Admin account (default username: admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_SESSION_SECRET=long-random-string

# SMTP — auto-sends custom reminder emails on scan
   MAIL_EMAIL=you@gmail.com
   MAIL_PASSWORD=your-16-character-app-password

# Optional: UPI QR (India). If empty, QR encodes the /pay page URL instead.
PAYMENT_UPI_ID=yourname@upi
PAYMENT_PAYEE_NAME=Your Business
PAYMENT_NOTE_PREFIX=INV
